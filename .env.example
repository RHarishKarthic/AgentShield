# =============================================================================
# AgentShield — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file to version control.
# =============================================================================

# --- Application ---
APP_NAME=AgentShield
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# --- API Security ---
# Generate a strong random key: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_SECRET_KEY=change-me-to-a-strong-random-secret
WAF_API_KEY=change-me-to-a-strong-api-key

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=agentshield
POSTGRES_USER=agentshield
POSTGRES_PASSWORD=change-me-strong-password
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}

# --- Tool Services ---
CUSTOMER_SERVICE_URL=http://localhost:8001
EMAIL_SERVICE_URL=http://localhost:8002
FILE_SERVICE_URL=http://localhost:8003

# --- LLM Configuration ---
# Provider: "ollama" or "openai" or "anthropic"
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# For OpenAI (optional, for production)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# For Anthropic (optional)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Server ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
